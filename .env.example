# Create/connect a Neon database in Vercel > Storage. Never use NEXT_PUBLIC_ for secrets.
DATABASE_URL=
# Existing Vercel Neon integration: keep WEEDING exactly as configured. No need to fill both.
# DATABASE_URL takes precedence if both are set. Neither name is client-side/public.
DATABASE_WEEDING_DATABASE_URL=
# The actual public Vercel URL, without a path. Fill in AFTER the first deployment.
SITE_URL=
NEXTAUTH_URL=
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
NEXTAUTH_SECRET=
# GitHub OAuth application; NOT the repository's access token.
# Callback: https://YOUR-SITE.vercel.app/api/auth/callback/github
GITHUB_ID=
GITHUB_SECRET=
# Comma-separated NUMERIC GitHub account IDs allowed to enter the private panel.
# Empty = nobody has access. A username or a request header never grants access.
ADMIN_GITHUB_IDS=
# Optional email notifications. Confirmations still save without these.
RSVP_NOTIFY_TO=
RSVP_EMAIL_FROM=
RESEND_API_KEY=
